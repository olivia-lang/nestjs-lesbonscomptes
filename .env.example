# Copier ce fichier en .env et adapter les valeurs
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lesbonscomptes
DB_PASSWORD=change-moi
DB_NAME=lesbonscomptes
# true = TypeORM crée/met à jour les tables depuis les entités au démarrage (dev uniquement, jamais en prod)
DB_SYNCHRONIZE=false

# secret qui signe les jetons de connexion (au moins 32 caractères) : openssl rand -hex 48
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-d-au-moins-32-caracteres
